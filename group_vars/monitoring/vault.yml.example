---
# Template for group_vars/monitoring/vault.yml (encrypted with Ansible Vault).
# Copy to vault.yml, fill in, encrypt: ansible-vault encrypt group_vars/monitoring/vault.yml
# The real vault.yml never enters git.

# Alertmanager SMTP delivery
vault_alertmanager_smtp_host: smtp.example.com:587
vault_alertmanager_smtp_from: alerts@example.com
vault_alertmanager_smtp_username: alerts@example.com
vault_alertmanager_smtp_password: changeme

# Alert destination
vault_alertmanager_email_to: you@example.com

# Grafana local admin
vault_grafana_admin_password: changeme

# Dead man's switch ping URL (healthchecks.io)
vault_watchdog_ping_url: https://hc-ping.com/00000000-0000-0000-0000-000000000000

# Blackbox probe targets (secret: real endpoints stay out of git).
# Each entry: target + labels attached to its Prometheus series.

# HTTPS probes (https_2xx module)
vault_blackbox_https_targets:
  - target: "https://www.example.com/"
    labels:
      group: example-site

# HTTPS probes without TLS verification (https_2xx_insecure module,
# for endpoints with self-signed certificates)
vault_blackbox_https_insecure_targets:
  - target: "https://192.0.2.9"
    labels:
      group: example-appliance

# HTTP probes (http_2xx module)
vault_blackbox_http_targets:
  - target: "http://192.0.2.10:8080"
    labels:
      group: example-app

# TCP reachability (tcp_connect module)
vault_blackbox_tcp_targets:
  - target: "192.0.2.11:22"
    labels:
      group: ssh-example

# DNS resolution via lab nameservers (dns module)
vault_blackbox_dns_targets:
  - target: "192.0.2.12:53"
    labels:
      group: resolve-example
