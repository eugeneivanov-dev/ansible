---
# Template for group_vars/monitoring/vault.yml (encrypted with Ansible Vault).
# Copy to vault.yml, fill in, encrypt: ansible-vault encrypt group_vars/monitoring/vault.yml
# The real vault.yml never enters git.

# Alertmanager SMTP delivery
vault_alertmanager_smtp_host: smtp.example.com:587
vault_alertmanager_smtp_from: alerts@example.com
vault_alertmanager_smtp_username: alerts@example.com
vault_alertmanager_smtp_password: changeme

# Alert destination
vault_alertmanager_email_to: you@example.com

# Grafana local admin
vault_grafana_admin_password: changeme

# Dead man's switch ping URL (healthchecks.io)
vault_watchdog_ping_url: https://hc-ping.com/00000000-0000-0000-0000-000000000000
