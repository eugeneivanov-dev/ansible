---
# Ansible Vault variables — template.
# Copy to group_vars/rhel/vault.yml, fill in real values, encrypt:
#   ansible-vault encrypt group_vars/rhel/vault.yml
# The real vault.yml never enters git (see .gitignore).

# Red Hat Subscription Manager credentials (rhel hosts)
vault_rhsm_username: "your-rhsm-username"
vault_rhsm_password: "your-rhsm-password"
