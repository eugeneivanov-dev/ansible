[Unit]
Description=acme.sh renewal pass (step-ca certificates)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ svc_grafana_acme_home }}/acme.sh --cron --home {{ svc_grafana_acme_home }} --config-home {{ svc_grafana_acme_config_home }}

# hardening v2: deferred (task profile candidate)
# root is required: standalone HTTP-01 binds port 80 and the reload command
# calls systemctl. Hardening is postponed until the renewal path has been
# verified in production after the /root relocation (refs #8), so a sandboxing
# change is not mixed into that verification. Planned shape:
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE, ProtectSystem=strict with
# ReadWritePaths for the acme state and the certificate directory, the rest
# of the service block unchanged.
