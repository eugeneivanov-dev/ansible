    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Storage usage as reported by the Proxmox exporter for configured Proxmox storage pools.\n\nThis panel shows Proxmox storage objects such as local, local-lvm, and backup. The node disk entry may duplicate local storage when both refer to the same underlying root filesystem, so storage/* is preferred for tracking Proxmox storage usage.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "#EAB839",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
