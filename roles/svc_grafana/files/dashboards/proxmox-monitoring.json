          "expr": "pve_up{id=~\"qemu/.*\"}\n* on(id) group_left(name)\nmax by (id, name) (pve_guest_info{id=~\"qemu/.*\"})",
          "instant": false,
          "legendFormat": "{{name}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Proxmox Objects Up",
      "type": "stat"
