{{ ansible_managed | comment }}
[Unit]
Description=Prometheus Node Exporter
Documentation=https://prometheus.io/docs/guides/node-exporter/
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
Group=node_exporter
ExecStart=/usr/local/bin/node_exporter{% if ubuntu_monitoring_agent_textfile_dir %} --collector.textfile.directory={{ ubuntu_monitoring_agent_textfile_dir }}{% endif %}

Restart=on-failure

# hardening v2 (service)
# ProtectClock omitted: timex collector calls adjtimex (nixpkgs exporters/node.nix)
# AF_NETLINK added: netdev collector uses netlink sockets (nixpkgs exporters/node.nix)
# @clock allowed: timex collector calls adjtimex; CAP_SYS_TIME is empty so writes
# are denied by the kernel (SIGSYS coredump verified on test240)
# open_tree+fsopen allowed: pathrs-lite probes open_tree at init and then uses
# fsopen for a private procfs handle; SIGSYS kills both (audit syscall=428, 430,
# coredumps verified on test240). A per-syscall ENOSYS action does not exist for
# allowlist filters and a global SystemCallErrorNumber would silence every future
# violation, so the two calls are allowed; abusive use is gated by the empty
# capability set (fsopen and open_tree clones need CAP_SYS_ADMIN)
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
DeviceAllow=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
UMask=0077
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=@clock
SystemCallFilter=open_tree fsopen

[Install]
WantedBy=multi-user.target
