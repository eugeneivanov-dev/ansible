{{ ansible_managed | comment }}
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - "{{ svc_prometheus_config_dir }}/rules/*.rules.yml"

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - 127.0.0.1:9090

  - job_name: node
    file_sd_configs:
      - files:
          - "{{ svc_prometheus_config_dir }}/targets/node_*.json"
