{{ ansible_managed | comment }}
[Unit]
Description=Prometheus Node Exporter
Documentation=https://prometheus.io/docs/guides/node-exporter/
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
Group=node_exporter
ExecStart=/usr/local/bin/node_exporter
Restart=on-failure

# hardening v2 (service)
# ProtectClock omitted: timex collector calls adjtimex (nixpkgs exporters/node.nix)
# AF_NETLINK added: netdev collector uses netlink sockets (nixpkgs exporters/node.nix)
# @clock allowed: timex collector calls adjtimex; CAP_SYS_TIME is empty so writes
# are denied by the kernel (SIGSYS coredump verified on test240)
# open_tree denied with ENOSYS (not SIGSYS): pathrs-lite probes it once at init
# and falls back cleanly, as on kernels without the mount API (SIGSYS coredump
# verified on test240, audit syscall=428)
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
DeviceAllow=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
UMask=0077
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=@clock
SystemCallFilter=~open_tree:ENOSYS

[Install]
WantedBy=multi-user.target
